{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kohler-ai-bathroom-intelligence.local/contracts/hybrid-plan-response.schema.json",
  "title": "KOHLER Hybrid Plan Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "status", "provider", "generatedAt", "confidence", "observations", "retrieval", "constraints", "optimization", "signals", "warnings"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 8, "maxLength": 100 },
    "status": { "type": "string", "enum": ["ok", "partial", "failed"] },
    "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomGeometry", "imageAnalysis"],
      "properties": {
        "roomGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthMm", "depthMm", "heightMm", "source", "confidence"],
          "properties": {
            "widthMm": { "type": "integer", "minimum": 0 },
            "depthMm": { "type": "integer", "minimum": 0 },
            "heightMm": { "type": "integer", "minimum": 0 },
            "source": { "type": "string", "enum": ["user-entered", "user-confirmed", "ai-estimate", "mixed"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "imageAnalysis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observations", "confidence"],
          "properties": {
            "status": { "type": "string", "enum": ["not_requested", "not_configured", "completed", "failed"] },
            "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" }, "maxItems": 100 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "imageStoragePath": { "type": "string", "maxLength": 500 }
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "backend", "candidates", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["not_requested", "completed", "partial", "failed"] },
        "backend": { "type": "string", "enum": ["chroma", "node-catalogue-contract", "none"] },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" }, "maxItems": 200 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "maxItems": 200 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "review", "conflict"] },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/constraint" }, "maxItems": 100 }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "objective", "selectedSkus", "alternatives"],
      "properties": {
        "status": { "type": "string", "enum": ["not_run", "completed", "partial", "failed"] },
        "objective": { "type": "string", "maxLength": 1000 },
        "selectedSkus": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "maxItems": 200 },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/alternative" }, "maxItems": 3 }
      }
    },
    "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" }, "maxItems": 200 },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 50 },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceVersion": { "type": "string" },
        "models": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "latencyMs": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["key", "value", "confidence", "source"],
      "properties": { "key": { "type": "string" }, "value": {}, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "type": "string" } }
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["sku", "score", "reasons"],
      "properties": { "sku": { "type": "string" }, "score": { "type": "number" }, "reasons": { "type": "array", "items": { "type": "string" }, "maxItems": 20 } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["type", "reference", "detail", "confidence"],
      "properties": { "type": { "type": "string" }, "reference": { "type": "string" }, "detail": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "constraint": {
      "type": "object", "additionalProperties": false, "required": ["key", "status", "detail"],
      "properties": { "key": { "type": "string" }, "status": { "type": "string", "enum": ["pass", "review", "conflict"] }, "detail": { "type": "string" } }
    },
    "alternative": {
      "type": "object", "additionalProperties": false, "required": ["id", "skus", "score", "rationale"],
      "properties": { "id": { "type": "string" }, "skus": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "score": { "type": "number" }, "rationale": { "type": "string" } }
    },
    "signal": {
      "type": "object", "additionalProperties": false, "required": ["key", "value", "confidence", "source"],
      "properties": { "key": { "type": "string" }, "value": {}, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "type": "string" } }
    }
  }
}
